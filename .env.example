# ==============================================================================
# DATABASE CONFIGURATION (MySQL)
# ==============================================================================

# Auth Service Database
MYSQL_AUTH_ROOT_PASSWORD=<YOUR_AUTH_DB_ROOT_PASSWORD>
MYSQL_AUTH_DATABASE=auth_db

# Inventory (Kho) Service Database
MYSQL_KHO_ROOT_PASSWORD=<YOUR_KHO_DB_ROOT_PASSWORD>
MYSQL_KHO_DATABASE=kho_db

# Order Service Database
MYSQL_ORDER_ROOT_PASSWORD=<YOUR_ORDER_DB_ROOT_PASSWORD>
MYSQL_ORDER_DATABASE=order_db

# Payment Service Database
MYSQL_PAYMENT_ROOT_PASSWORD=<YOUR_PAYMENT_DB_ROOT_PASSWORD>
MYSQL_PAYMENT_DATABASE=payment_db

# ==============================================================================
# INFRASTRUCTURE (Kafka, Zookeeper, Redis)
# ==============================================================================

# Zookeeper
ZOOKEEPER_CLIENT_PORT=2181

# Kafka
KAFKA_BROKER_ID=1
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
KAFKA_NUM_PARTITIONS=3
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1

# Redis
REDIS_HOST=redis_kho

# ==============================================================================
# MICROSERVICES SETTINGS
# ==============================================================================

# Common Spring Kafka
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
SPRING_KAFKA_PRODUCER_KEY_SERIALIZER=org.apache.kafka.common.serialization.StringSerializer
SPRING_KAFKA_PRODUCER_VALUE_SERIALIZER=org.springframework.kafka.support.serializer.JsonSerializer

# --- Auth Service ---
AUTH_SPRING_DATASOURCE_URL=jdbc:mysql://mysql_auth:3306/auth_db?allowPublicKeyRetrieval=true&useSSL=false&useUnicode=true&characterEncoding=UTF-8
AUTH_SPRING_DATASOURCE_USERNAME=<YOUR_AUTH_DB_USER>
AUTH_SPRING_DATASOURCE_PASSWORD=<YOUR_AUTH_DB_PASSWORD>
AUTH_JAVA_TOOL_OPTIONS="-XX:ActiveProcessorCount=2 -XX:MaxRAMPercentage=75 -Djava.util.concurrent.ForkJoinPool.common.parallelism=2"
JWT_SECRET=<YOUR_JWT_SECRET_KEY>

# --- Notification Service ---
NOTIFICATION_KAFKA_CONSUMER_GROUP_ID=notification-group-v2
NOTIFICATION_KAFKA_LISTENER_CONCURRENCY=3
NOTIFICATION_JAVA_TOOL_OPTIONS="-XX:ActiveProcessorCount=1 -XX:MaxRAMPercentage=75 -Djava.util.concurrent.ForkJoinPool.common.parallelism=1"

# --- Inventory Service ---
INVENTORY_SPRING_DATASOURCE_URL=jdbc:mysql://mysql_kho:3306/kho_db?allowPublicKeyRetrieval=true&useSSL=false&useUnicode=true&characterEncoding=UTF-8
INVENTORY_SPRING_DATASOURCE_USERNAME=<YOUR_KHO_DB_USER>
INVENTORY_SPRING_DATASOURCE_PASSWORD=<YOUR_KHO_DB_PASSWORD>
INVENTORY_JAVA_TOOL_OPTIONS="-XX:ActiveProcessorCount=2 -XX:MaxRAMPercentage=75 -Djava.util.concurrent.ForkJoinPool.common.parallelism=2"
CLOUDINARY_URL=<YOUR_CLOUDINARY_URL>

# --- Order Service ---
ORDER_SPRING_DATASOURCE_URL=jdbc:mysql://mysql_order:3306/order_db?allowPublicKeyRetrieval=true&useSSL=false&useUnicode=true&characterEncoding=UTF-8
ORDER_SPRING_DATASOURCE_USERNAME=<YOUR_ORDER_DB_USER>
ORDER_SPRING_DATASOURCE_PASSWORD=<YOUR_ORDER_DB_PASSWORD>
ORDER_JAVA_TOOL_OPTIONS="-XX:ActiveProcessorCount=2 -XX:MaxRAMPercentage=75 -Djava.util.concurrent.ForkJoinPool.common.parallelism=2"
INVENTORY_BASE_URL=http://inventory-service:8080

# --- Payment Service ---
PAYMENT_SPRING_DATASOURCE_URL=jdbc:mysql://mysql_payment:3306/payment_db?allowPublicKeyRetrieval=true&useSSL=false&useUnicode=true&characterEncoding=UTF-8
PAYMENT_SPRING_DATASOURCE_USERNAME=<YOUR_PAYMENT_DB_USER>
PAYMENT_SPRING_DATASOURCE_PASSWORD=<YOUR_PAYMENT_DB_PASSWORD>
PAYMENT_JAVA_TOOL_OPTIONS="-XX:ActiveProcessorCount=1 -XX:MaxRAMPercentage=75 -Djava.util.concurrent.ForkJoinPool.common.parallelism=1"
VNPAY_TMN_CODE=<YOUR_VNPAY_TMN_CODE>
VNPAY_HASH_SECRET=<YOUR_VNPAY_HASH_SECRET>
VNPAY_RETURN_URL=<YOUR_VNPAY_RETURN_URL>

# --- Gateway Service ---
GATEWAY_JAVA_TOOL_OPTIONS="-XX:ActiveProcessorCount=1 -XX:MaxRAMPercentage=75 -Djava.util.concurrent.ForkJoinPool.common.parallelism=1"

# ==============================================================================
# MAIL SERVICE CONFIGURATION
# ==============================================================================

APP_ADMIN_SUPPORT_EMAIL=<YOUR_ADMIN_EMAIL>
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_USERNAME=<YOUR_MAIL_USERNAME>
MAIL_PASSWORD=<YOUR_MAIL_APP_PASSWORD>